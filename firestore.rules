rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA — Taise Rufino Fotografia
//
// A ideia central: o navegador fala direto com o banco, então é AQUI que os
// dados dos clientes ficam protegidos. Nome, telefone e e-mail vivem em
// coleções que só o admin logado consegue ler. O visitante enxerga apenas
// data/hora/pacote/status, que é o necessário para escolher um horário.
//
// Onde colar: Firebase → Firestore Database → aba "Regras" → Publicar.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Contas autorizadas a administrar o site. Para liberar outra pessoa,
    // acrescente o identificador dela nesta lista e publique de novo.
    function ehAdmin() {
      return request.auth != null
          && request.auth.uid in [
               'PIyrdiQ5DXVJuRQFSSJ84yLtl7A2'
             ];
    }

    // Cada pessoa só enxerga o próprio registro de admin, e ninguém cria
    // admin pelo site — isso é feito à mão no console do Firebase.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Disponibilidade pública. Nunca guarde dado pessoal aqui: qualquer
    // visitante do site lê esta coleção inteira. O hasOnly abaixo é o que
    // garante isso na prática — nome, CPF, telefone e e-mail não têm como
    // entrar, nem por engano no código nem de propósito por fora dele.
    // É esta separação que deixa a agenda pública sem expor ninguém.
    match /horarios/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys()
                       .hasOnly(['date','time','package','lot','status'])
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10
                    && request.resource.data.time is string
                    && request.resource.data.time.size() <= 5;
      allow update, delete: if ehAdmin();
    }

    // Agendamento completo, com dados pessoais (nome, CPF, telefone, e-mail).
    // Só o admin lê, altera ou apaga — nenhum visitante do site alcança isto.
    // Criar continua aberto, porque é o formulário do site que grava, mas não
    // é mais um cheque em branco: a criação passa por validação de formato e
    // de tamanho, para ninguém despejar lixo (ou um texto gigante) na coleção.
    match /agendamentos/{id} {
      allow read, update, delete: if ehAdmin();
      allow create: if agendamentoValido();
    }

    // LGPD, minimização e integridade: campo que não está previsto aqui não
    // entra, e cada texto tem teto de tamanho. Só os cinco primeiros são
    // obrigatórios; o resto é opcional para não quebrar pedidos antigos.
    function agendamentoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','phone','email','date','time','status'])
          && d.keys().hasOnly([
               'id','name','cpf','phone','email','package','lot','lotPrice',
               'semanaNota','addons','addonsValor','addonIds','addonQtd',
               'total','pagamento','lotVagas',
               'date','time','status','notes','createdAt','updatedAt',
               'petLeva','petRaca','petPorte','usoImagem','consentimento'
             ])
          && d.name is string && d.name.size() > 2 && d.name.size() <= 120
          && d.email is string && d.email.size() <= 160 && d.email.matches('.+@.+')
          && d.phone is string && d.phone.size() <= 40
          && d.date is string && d.date.size() == 10
          && d.time is string && d.time.size() <= 5
          // CPF chega só em dígitos; nunca mais de 11, nada além de número.
          && (!('cpf' in d) || (d.cpf is string && d.cpf.size() <= 11 && d.cpf.matches('^[0-9]*$')))
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 1000))
          && (!('petRaca' in d) || (d.petRaca is string && d.petRaca.size() <= 60))
          && (!('petPorte' in d) || (d.petPorte is string && d.petPorte.size() <= 20))
          && (!('petLeva' in d) || d.petLeva in ['sim','nao'])
          && (!('usoImagem' in d) || d.usoImagem in ['sim','nao'])
          // Pedido nasce pendente: ninguém se autoconfirma pelo formulário.
          && d.status == 'pendente';
    }

    // Marca de "esse contato está na lista VIP".
    // Este documento é consultado por qualquer visitante (get pontual) para
    // validar quem chega pela lista VIP. Por isso ele NÃO guarda nome nem
    // qualquer dado pessoal: só a marca de que o contato está na lista. Quem
    // souber o e-mail de alguém descobre apenas que ela é VIP, nada além.
    // O nome fica em "vipCadastros", que só o admin lê. O "list" segue
    // bloqueado para o público: é isso que impede baixar a lista inteira.
    match /vipMembros/{chave} {
      allow get: if true;
      allow list: if ehAdmin();
      allow create: if request.resource.data.keys().hasOnly(['vip']);
      allow update, delete: if ehAdmin();
    }

    // Cadastro VIP com dados pessoais: mesma lógica dos agendamentos, com a
    // mesma validação de formato e tamanho na criação.
    match /vipCadastros/{id} {
      allow read, update, delete: if ehAdmin();
      allow create: if request.resource.data.keys().hasAll(['name','email'])
                    && request.resource.data.keys().hasOnly(
                         ['id','name','email','phone','createdAt','consentimento'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 160;
    }

    // Estado do VIP (ligado, lançamento, cadastro aberto). O site precisa ler
    // para saber o que mostrar; só o admin muda.
    match /config/vip {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Horários criados à mão pela guia "Agenda" do painel. O site inteiro
    // precisa ler: é isso que faz a vaga extra aparecer no agendamento. Nunca
    // guarde dado pessoal aqui — só data e hora.
    match /config/agenda {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Contador de vagas VIP. Leitura livre para mostrar "x vagas restantes".
    // Uma inscrição só pode somar 1 e não pode tocar em nenhum outro campo,
    // então ninguém zera nem adultera o contador pelo navegador.
    match /config/contadorVip {
      allow read: if true;
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin()
                    || (request.resource.data.keys().hasOnly(['cadastros'])
                        && request.resource.data.cadastros is int
                        && request.resource.data.cadastros == resource.data.cadastros + 1);
    }

    // Qualquer coisa fora do que está descrito acima fica bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
